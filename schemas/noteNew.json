{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "teamNumber",
        "eventCode",
        "scoutId",
        "noteTitle",
        "noteText"
    ],
    "properties": {
        "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the note"
        },
        "teamNumber": {
            "type": "integer",
            "description": "Team number associated with the note"
        },
        "eventCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Event code identifier"
        },
        "scoutId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the scout creating the note"
        },
        "noteTitle": {
            "type": "string",
            "maxLength": 255,
            "description": "Title of the note"
        },
        "noteText": {
            "type": "string",
            "description": "Content of the note"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the note was created"
        }
    },
    "additionalProperties": false
}