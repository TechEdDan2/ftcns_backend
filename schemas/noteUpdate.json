{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "example": {
        "noteTitle": "Great Performance",
        "noteText": "The team performed exceptionally well in the last match, showing great teamwork and strategy."
    },
    "properties": {
        "noteTitle": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "description": "Title of the note"
        },
        "noteText": {
            "type": "string",
            "minLength": 1,
            "description": "Content of the note"
        }
    },
    "minProperties": 1,
    "additionalProperties": false,
    "required": []
}